# =============================================================================
# FoodRescue-LK — Backend Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in your PostgreSQL credentials.
# In production, set these as system/server environment variables instead.

# PostgreSQL Connection String
# Format: Host=<host>;Database=<dbname>;Username=<user>;Password=<password>
ConnectionStrings__DefaultConnection=Host=localhost;Database=foodrescue_lk;Username=postgres;Password=YOUR_POSTGRES_PASSWORD

# ASP.NET Core environment (Development | Production)
ASPNETCORE_ENVIRONMENT=Development

# Port the backend runs on (matches frontend API URL)
ASPNETCORE_URLS=http://localhost:5184
