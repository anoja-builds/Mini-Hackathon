# =============================================================================
# FoodRescue-LK — Frontend Environment Variables Example
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEXT_PUBLIC_ prefix makes variables accessible in the browser.

# Backend API base URL
# Default: http://localhost:5184/api (local ASP.NET Core backend)
NEXT_PUBLIC_API_URL=http://localhost:5184/api
